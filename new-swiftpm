#!/bin/bash -e

if [ $# -lt 1 ]; then
    echo "usage: $0 <name> [<src-branch>]"
    exit 1
fi

source=bare
name=$1

if [ -n "$2" ]; then
    branch=$2
else
    branch=main
fi

mkdir $name

make-wt() {
    git -C $source/$1.git worktree prune
    git -C $source/$1.git worktree add -b $name $(pwd)/$name/$1 $branch
}

make-wt swift-build
make-wt swift-package-manager
make-wt sourcekit-lsp

mkdir -p $name/$name.xcworkspace

cat > $name/$name.xcworkspace/contents.xcworkspacedata <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<Workspace
   version = "1.0">
   <FileRef
      location = "group:swift-build">
   </FileRef>
   <FileRef
      location = "group:swift-package-manager">
   </FileRef>
   <FileRef
      location = "group:sourcekit-lsp">
   </FileRef>
</Workspace>
EOF
